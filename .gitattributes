# Нормализация переводов строк: в репозитории — LF.
* text=auto eol=lf

# Бинарные файлы: без преобразований.
*.png binary
*.woff2 binary
*.ico binary

# Явно текстовые.
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.txt  text eol=lf
Dockerfile text eol=lf
