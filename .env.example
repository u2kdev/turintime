# ── Обязательное ───────────────────────────────────────────────────────────
# Токен Telegram-бота от @BotFather. Без него бот просто не запустится,
# веб-приложение продолжит работать.
BOT_TOKEN=
BOT_USERNAME=

# ── Адрес, по которому доступно приложение (для ссылок и PWA) ──────────────
BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# ── Секреты ────────────────────────────────────────────────────────────────
# Токен для ручного обновления расписания: POST /api/refresh
# Заголовок X-Admin-Token. Если пусто — доступ только с localhost.
ADMIN_TOKEN=
SECRET_KEY=change-me

# ── Источник данных ────────────────────────────────────────────────────────
EDUPAGE_ORIGIN=https://ttpu.edupage.org
SCHOOL_NAME=Turin Polytechnic University in Tashkent
SCHOOL_SHORT=TTPU
TIMEZONE=Asia/Tashkent

# ── Расписание ─────────────────────────────────────────────────────────────
# Как часто перекачивать расписание с EduPage (в часах)
REFRESH_HOURS=6
# Обновлять при старте сервера
REFRESH_ON_START=true

# ── Telegram-бот ───────────────────────────────────────────────────────────
RUN_BOT=true
# Время утренней рассылки по умолчанию (местное, Asia/Tashkent)
DAILY_DEFAULT_TIME=07:30
# За сколько минут предупреждать о паре
REMINDER_MINUTES=15
